# Set this on the backend only. Never add the real key to source control.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
DATABASE_URL=sqlite:///./fomuwise.db
DOCUMENT_TTL_HOURS=12
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=30
MAX_TEXT_CHARS=120000
MAX_QUESTION_LENGTH=500
MAX_PROMPT_CHARS=24000
FRONTEND_ORIGIN=http://localhost:5173
# Per AI call, including JSON repair (maximum two calls); allowed 1000–45000 ms.
AI_TIMEOUT_MS=40000
